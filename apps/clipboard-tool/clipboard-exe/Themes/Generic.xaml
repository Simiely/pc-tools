<!-- Themes/Generic.xaml - NeuBorder 默认模板
     凸起：ShHi(左上浅灰高光投影) + ShLo(右下深影) 双投影层，无描边
     内嵌：四边 Rectangle（top/left 暗 + bottom/right 亮） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ClipboardExe.Controls">

    <Style TargetType="local:NeuBorder">
        <Setter Property="Background" Value="{StaticResource ElevBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NeuBorder">
                    <Grid>
                        <!-- 双投影层：几乎透明（alpha 1）仅作投影载体，不改变本体视觉 -->
                        <Border x:Name="ShHi" Background="#01000000" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <Border x:Name="ShLo" Background="#01000000" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter/>
                        </Border>
                        <Rectangle x:Name="EdgeTop" Height="1" VerticalAlignment="Top" Margin="2,1,2,0" Visibility="Collapsed"/>
                        <Rectangle x:Name="EdgeBottom" Height="1" VerticalAlignment="Bottom" Margin="2,0,2,1" Visibility="Collapsed"/>
                        <Rectangle x:Name="EdgeLeft" Width="1" HorizontalAlignment="Left" Margin="1,2,0,2" Visibility="Collapsed"/>
                        <Rectangle x:Name="EdgeRight" Width="1" HorizontalAlignment="Right" Margin="0,2,1,2" Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
