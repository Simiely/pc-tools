<!-- Controls/DataDialog.xaml - 数据管理（本地备份 + WebDAV 同步） -->
<UserControl x:Class="ClipboardExe.Controls.DataDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540">
    <Border Style="{StaticResource ModalCard}">
        <StackPanel>
            <DockPanel Style="{StaticResource ModalHead}">
                <TextBlock Text="数据管理" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="本地备份可导出 / 导入 / 清空；WebDAV 同步把数据备份到你的服务器（服务器信息仅保存于本地）。"
                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

            <!-- ① 本地备份 -->
            <Border Style="{StaticResource SecCard}">
                <StackPanel>
                    <DockPanel Style="{StaticResource SecTitle}">
                        <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusIconSm}" Background="{StaticResource BgBrush}"
                                DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="1" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="本地备份" FontSize="13" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </DockPanel>

                    <TextBlock Text="导出全部（含归档）为 JSON 文件；导入合并（同 id 取新）；清空不可撤销。"
                               FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <Button Content="导出全部（含归档）" Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,10" Click="Export_Click"/>
                    <Button Content="导入合并…" Style="{StaticResource BtnGhost}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,12" Click="Import_Click"/>

                    <TextBlock Text="危险区 · 清空后无法恢复" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    <Button Content="全部清空（含归档）" Style="{StaticResource BtnDanger}"
                            HorizontalAlignment="Stretch" Click="Clear_Click"/>
                </StackPanel>
            </Border>

            <!-- ② WebDAV 同步 -->
            <Border Style="{StaticResource SecCard}" Margin="0">
                <StackPanel>
                    <DockPanel Style="{StaticResource SecTitle}">
                        <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusIconSm}" Background="{StaticResource BgBrush}"
                                DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="2" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="WebDAV 同步" FontSize="13" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource DimBrush}"
                                   VerticalAlignment="Center" Text="信息仅保存于本地"/>
                    </DockPanel>

                    <TextBlock Text="账号昵称（可选）" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="NickBox" Style="{StaticResource EditInput}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="NickHint" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,0,0,10"
                               Text="同步后其它设备可见；留空则显示账号名"/>

                    <TextBlock Text="服务器地址" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="UrlBox" Style="{StaticResource EditInput}" Margin="0,0,0,10"/>

                    <TextBlock Text="用户名" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="UserBox" Style="{StaticResource EditInput}" Margin="0,0,0,10"/>

                    <TextBlock Text="密码" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PwdBox" Style="{StaticResource EditPassword}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="PwdHint" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,2,0,12"/>

                    <CheckBox x:Name="SyncFilesChk" Content="同步文件实体（图片 / 附件；关闭后不备份上云，但本机仍会尝试从云端拉回缺失的实体）"
                              Foreground="{StaticResource TextBrush}" Margin="0,2,0,8"/>
                    <CheckBox x:Name="AutoSyncChk" Content="自动同步"
                              Foreground="{StaticResource TextBrush}" Margin="0,2,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="同步间隔（分钟）" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="IntervalBox" Grid.Column="1" Style="{StaticResource EditInput}"
                                 Width="92" Margin="10,0,0,0" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 同步状态 -->
            <Border x:Name="StatusCard" Background="{StaticResource InsetBrush}" CornerRadius="{StaticResource RadiusBtn}"
                    Padding="12,9" Margin="0,0,0,4" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- 操作行 -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="测试连接并保存" Grid.Column="0" Style="{StaticResource BtnPrimary}"
                        MinWidth="150" Margin="0,0,10,0" Click="TestSave_Click"/>
                <Button Content="立即同步" Grid.Column="1" Style="{StaticResource BtnGhost}"
                        MinWidth="110" Margin="0,0,10,0" Click="SyncNow_Click"/>
                <Button Content="关闭" Grid.Column="2" Style="{StaticResource BtnClose}"
                        MinWidth="88" Click="Close_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
