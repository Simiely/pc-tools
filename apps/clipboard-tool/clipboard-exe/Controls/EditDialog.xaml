<!-- Controls/EditDialog.xaml - 编辑弹窗（对齐 app.js openEditModal，M3a 范围：文本/链接；富文本/图片/文件 M3b+）
     结构：edit-head（图标 + 编辑 · 标题 + edit-type 徽章）/ [重复常驻提示] / ① 内容区 / ② 元数据（别名+过期+标签）
           / 操作行（归档 + 保存 + 取消） -->
<UserControl x:Class="ClipboardExe.Controls.EditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ClipboardExe.Controls"
             Width="600">
    <Border Style="{StaticResource ModalCard}">
        <StackPanel>
            <!-- edit-head：类型图标 + 标题 + 类型徽章 -->
            <DockPanel Style="{StaticResource ModalHead}">
                <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusIconLg}" Background="{StaticResource InsetBrush}"
                        DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadIcon" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="HeadTitle" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"
                           Margin="10,0,10,0" TextTrimming="CharacterEllipsis"/>
                <ContentControl x:Name="TypeBadge" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 重复常驻提示（.edit-dup：⚠️ 已有相同内容 / 可修改标题或标签）+ 右上「＋ 新建」直达干净存入窗 -->
            <Border x:Name="DupTip" Style="{StaticResource DupTip}" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="DupNewBtn" DockPanel.Dock="Right" Style="{StaticResource BtnGhostSm}"
                            Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Top"
                            Visibility="Collapsed" Content="＋ 新建"
                            ToolTip="不编辑这条已有内容，打开空白存入窗手动录入一条新内容"
                            Click="DupNew_Click"/>
                    <StackPanel>
                        <TextBlock Text="⚠️ 已有相同内容" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="可修改标题或标签，方便下次检索；或点右侧「新建」录入全新内容" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ① 内容区（.edit-sec） -->
            <Border Style="{StaticResource SecCard}">
                <StackPanel>
                    <DockPanel Style="{StaticResource SecTitle}">
                        <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusIconSm}" Background="{StaticResource BgBrush}"
                                DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="1" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Sec1Title" FontSize="13" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <!-- v0.7.3：富文本卡「清除格式」按钮（对齐 Web v0.6.13，仅 Html 非空的格式文本卡显示）——
                             点击标记 → 保存时 html 置空转纯文本；再点取消 -->
                        <Button x:Name="ClearFmtBtn" DockPanel.Dock="Right" Style="{StaticResource BtnGhostSm}"
                                Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="Collapsed" Content="清除格式"
                                ToolTip="不需要保留格式时点击，保存后该条目将变为纯文本（不再带字体/颜色/对齐等格式）"
                                Click="ClearFmt_Click"/>
                        <TextBlock x:Name="Sec1Hint" DockPanel.Dock="Right" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="ContentBox" MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="13" Style="{StaticResource EditInput}"/>
                </StackPanel>
            </Border>

            <!-- ② 元数据区（.edit-sec：别名 + 过期 + 标签） -->
            <Border Style="{StaticResource SecCard}" Margin="0">
                <StackPanel>
                    <DockPanel Style="{StaticResource SecTitle}">
                        <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusIconSm}" Background="{StaticResource BgBrush}"
                                DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="2" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="元数据" FontSize="13" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="126"/><!-- Web .edit-row select{flex:0 0 126px} -->
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleBox" Grid.Column="0" Tag="别名" FontSize="12.5" Style="{StaticResource EditInput}"/>
                        <!-- Web .edit-sec select：background elev(#1F1F1F) / r-9 / padding 10px 12px；此处用 Bg 填充 + 1px 边框拉开与分区卡对比 -->
                        <ComboBox x:Name="ExpireBox" Grid.Column="1" Style="{StaticResource DarkCombo}"
                                  Background="{StaticResource BgBrush}" Padding="12,10"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                  ctl:Combo.Radius="{StaticResource RadiusCombo}"
                                  Margin="10,0,0,0" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <ctl:TagPicker x:Name="TagPick" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 操作行（对齐 Web .paste-actions：保存 flex:1 占满剩余=最大面积居中；归档/取消 btn-close 固定 88px 小按钮） -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ArchiveBtn" Content="归档" Style="{StaticResource BtnClose}" MinWidth="88"
                        Margin="0,0,10,0" Click="Archive_Click" ToolTip="移入归档区——「含归档」可查看，可恢复或删除"/>
                <Button Grid.Column="1" Content="保存" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0" Click="Save_Click"/>
                <Button Grid.Column="2" Content="取消" Style="{StaticResource BtnClose}" MinWidth="88" Click="Cancel_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
