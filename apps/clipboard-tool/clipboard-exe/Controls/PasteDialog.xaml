<!-- Controls/PasteDialog.xaml - 存入弹窗（对齐 app.js openPasteModal，M3a：文本/链接；M3b-2a：文件线）
     结构：p-head（📥 存入内容）/ paste-badge 实时类型徽章 + 清空 / textarea（Ctrl+Enter 存入）
           / file-chip 容器（选中文件显示 📎 名·大小 ✕）/ 高级选项（别名 + 过期 + 标签选择器）
           / 操作行（📁 选择文件 + 存入 + 关闭）/ 底部提示 -->
<UserControl x:Class="ClipboardExe.Controls.PasteDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ClipboardExe.Controls"
             Width="600" AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver">
    <Border Style="{StaticResource ModalCard}">
        <StackPanel>
            <!-- p-head：📥 图标块 + 存入内容 -->
            <DockPanel Style="{StaticResource ModalHead}">
                <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusIconLg}" Background="{StaticResource InsetBrush}"
                        DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="📥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="存入内容" FontSize="17" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>

            <!-- paste-badge-row：类型徽章（实时识别）+ 一键新建 / 清空 -->
            <DockPanel Margin="0,0,0,10">
                <ContentControl x:Name="TypeBadge" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Button Content="🗑 清空" Style="{StaticResource BtnGhostSm}" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="Clear_Click"
                        ToolTip="清空当前输入/已识别内容"/>
                <!-- v0.7.3：新建（手动录入一条新内容）——清除自动识别/填入的剪贴板文本与已选文件，回到空白手动输入态 -->
                <Button Content="＋ 新建" Style="{StaticResource BtnGhostSm}" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                        Click="New_Click"
                        ToolTip="忽略剪贴板自动识别，从空白开始手动输入一条新内容"/>
            </DockPanel>

            <!-- 输入区（对齐 .paste-modal textarea：min-height 150；Ctrl+Enter 快速存入） -->
            <TextBox x:Name="InputBox" MinHeight="150" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Tag="粘贴文本、链接，或拖文件到这里，一键存入…"
                     TextChanged="Input_TextChanged" PreviewKeyDown="Input_KeyDown"/>

            <!-- file-chip 容器（对齐 .file-chip：inset 底 + 📎 文件名 大小 + ✕；选中文件后隐藏 textarea） -->
            <StackPanel x:Name="ChipBox"/>

            <!-- 高级选项（.paste-adv：border-top；默认全展开——别名 / 过期 / 标签） -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Margin="0,14,0,0" Padding="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="138"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleBox" Grid.Column="0" Tag="别名（可留空，默认取首行）" FontSize="12.5"/>
                        <!-- Web .paste-adv .adv-row select：flex 0 0 138px / inset(#141414) 底 / r-10 / padding 10px 13px（与编辑弹窗 r-9/elev 底不同） -->
                        <ComboBox x:Name="ExpireBox" Grid.Column="1" Style="{StaticResource DarkCombo}"
                                  Padding="13,10" Margin="10,0,0,0" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <ctl:TagPicker x:Name="TagPick" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 操作行（对齐 Web .paste-actions{display:flex;gap:10px}）：
                 .btn-file flex:0 0 112px / 主按钮 存入 flex:1 = 占满剩余（最大面积居中）/ .btn-close flex:0 0 88px -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="📁 选择文件" Style="{StaticResource BtnFile}" Margin="0,0,10,0" Click="PickFileBtn_Click"/>
                <Button Grid.Column="1" Content="存入" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0" Click="Save_Click"/>
                <Button Grid.Column="2" Content="关闭" Style="{StaticResource BtnClose}" MinWidth="88" Click="Cancel_Click"/>
            </Grid>

            <!-- 底部提示 -->
            <TextBlock Text="Ctrl + Enter 快速存入 · 粘贴图片/文件自动识别"
                       Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
