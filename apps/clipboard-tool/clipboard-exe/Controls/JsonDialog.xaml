<!-- Controls/JsonDialog.xaml - JSON 格式化预览（对齐 app.js openJsonPreview；M3a 只读；M4c 加覆盖保存） -->
<UserControl x:Class="ClipboardExe.Controls.JsonDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="680">
    <Border Style="{StaticResource ModalCard}">
        <StackPanel>
            <DockPanel Style="{StaticResource ModalHead}">
                <TextBlock x:Name="HeadTitle" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <!-- 只读格式化 JSON（monospace 12px pre 折行滚动，对齐 openJsonPreview textarea 样式） -->
            <TextBox x:Name="JsonBox" MinHeight="320" MaxHeight="420" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, ui-monospace" FontSize="12"
                     Background="{StaticResource InsetBrush}"/>

            <StackPanel Style="{StaticResource ModalActions}">
                <Button Content="覆盖保存" Style="{StaticResource BtnPrimary}" MinWidth="130" Margin="0,0,10,0" Click="Save_Click"/>
                <Button Content="复制美化结果" Style="{StaticResource BtnGhost}" MinWidth="130" Margin="0,0,10,0" Click="Copy_Click"/>
                <Button Content="关闭" Style="{StaticResource BtnClose}" MinWidth="130" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
