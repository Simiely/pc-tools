<!-- Controls/CardView.xaml - 类型化卡片（对齐 app.js clipCard：row1 徽章行 / body 内容区 / foot meta+操作行）
     M3a 范围：文本卡 + 链接卡；文件/图片卡（M3b）；富文本分栏（M4，html 条目 M3a 降级显示纯文本 pv）
     视觉（对齐 index.html .clip-card）：
       - 统一等高 190px，elev 底 + r-lg（18）+ raised 阴影，hover → elev-hi 底 + 金色 .28 描边
       - pinned → amber .65 描边（GoldRingStrong，优先于 hover）
       - row1：类型徽章（.badge elev 底彩字）/ 标题（13.5 单行省略）/ 状态徽章（★置顶·⏳过期·归档）/ 右上 ✕ 删除
         （批量模式：✕ 原位替换为 26×26 勾选框，StatusSt/标题/行高不动 → 布局零位移）
       - body：文本=.pv 内嵌滚动摘要；链接=砖红 URL + ↗ 打开链接金色主按钮（M3a 仅此两种）
       - foot：meta（复制 N 次 / #tag 过滤 / 时间）+ ops（☆置顶 ✎编辑 {}JSON）
     事件（→ MainWindow 编排）：CopyBumped / Edit / TogglePin / Delete / OpenJson / OpenLink / TagFilter -->
<UserControl x:Class="ClipboardExe.Controls.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ClipboardExe.Controls"
             Height="190" Cursor="Hand"
             MouseLeftButtonUp="Card_MouseLeftButtonUp"
             MouseDoubleClick="Card_MouseDoubleClick">
    <Border x:Name="CardBorder"
            Background="{StaticResource ElevBrush}"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="10,14,10,12"
            ctl:BorderClip.ClipToRadius="True">
        <!-- 新拟态 raised 阴影（对齐 .clip-card box-shadow: sh-raised） -->
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.45" Direction="135"/>
        </Border.Effect>
        <!-- hover 金描边（.clip-card:hover 0 0 0 1.5px rgba(gold,.28)）；pinned 恒 amber .65（后声明优先） -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource GoldRingBrush}"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="pin">
                        <Setter Property="BorderBrush" Value="{StaticResource GoldRingStrongBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 行1：类型徽章 + 标题（填充）+ 状态徽章 + 右上 ✕ 删除
                 DockPanel 右对齐：先声明的 Dock=Right 占最右（对齐 Web row1: badge title status ops） -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <ContentControl x:Name="TypeBadge" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel x:Name="TopOpsPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                            Margin="6,0,0,0" VerticalAlignment="Center"/>
                <StackPanel x:Name="StatusPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                            Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 行2：内容区（类型专属） -->
            <ContentControl x:Name="BodyHost" Grid.Row="1"/>

            <!-- 行3：分隔线 + meta（复制次数/标签/时间）+ ops（☆置顶 ✎编辑 {}JSON）
                 ⚠️ MinHeight=35(分隔线行 1+8margin=9 + OpsIconBtn 26px)：批量模式隐藏 OpsPanel 后行高保持 35px,
                 否则塌到 ~15px → 卡高 190 固定下 Row1(body) 被拉高 = 卡片内容向下拉伸(用户反馈)。 -->
            <DockPanel Grid.Row="2" Margin="0,9,0,0" LastChildFill="True" MinHeight="35">
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                <StackPanel x:Name="MetaPanel" DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center"/>
                <StackPanel x:Name="OpsPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>

        </Grid>
    </Border>
</UserControl>
